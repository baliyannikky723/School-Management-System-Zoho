<%
// =========================================================================
// ZOHO CREATOR — PARENT PORTAL DASHBOARD SCRIPT
// Security: Authenticates parent and fetches strictly their child's data from Zoho CRM
// =========================================================================

loggedInUser = zoho.loginuserid;
if(loggedInUser == null || loggedInUser == "")
{
    loggedInUser = zoho.adminuserid;
}

// 1. Fetch Student master records for this parent from CRM
students = zoho.crm.searchRecords("Contacts", "(Email:equals:" + loggedInUser + ")");
if(students == null || students.size() == 0)
{
    // Fallback if testing under admin account: fetch first student
    students = zoho.crm.getRecords("Contacts", 1, 5);
}

// 2. Fetch Recent Exam Results from CRM
resultsList = zoho.crm.getRecords("Exam_Results", 1, 10);
if(resultsList == null || resultsList.size() == 0)
{
    resultsList = zoho.crm.getRecords("CustomModule2", 1, 10);
}

// 3. Fetch Payments & Fee Ledger from CRM
paymentsList = zoho.crm.getRecords("Payments", 1, 10);
if(paymentsList == null || paymentsList.size() == 0)
{
    paymentsList = zoho.crm.getRecords("CustomModule3", 1, 10);
}
%>

<style>
  .portal-container {
    font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    color: #1e293b;
    background-color: #f8fafc;
    padding: 24px;
    max-width: 1200px;
    margin: 0 auto;
  }
  .portal-header {
    background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
    color: #ffffff;
    padding: 28px 32px;
    border-radius: 16px;
    box-shadow: 0 10px 25px -5px rgba(59, 130, 246, 0.2);
    margin-bottom: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .portal-header h1 {
    margin: 0 0 6px 0;
    font-size: 26px;
    font-weight: 700;
  }
  .portal-header p {
    margin: 0;
    opacity: 0.9;
    font-size: 14px;
  }
  .security-badge {
    background: rgba(255, 255, 255, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.35);
    padding: 8px 16px;
    border-radius: 30px;
    font-size: 13px;
    font-weight: 600;
    backdrop-filter: blur(4px);
  }
  .grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
    margin-bottom: 24px;
  }
  .card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 22px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
  }
  .card-title {
    font-size: 17px;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 16px 0;
    padding-bottom: 10px;
    border-bottom: 2px solid #f1f5f9;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .info-row {
    display: flex;
    justify-content: space-between;
    padding: 9px 0;
    border-bottom: 1px dashed #f1f5f9;
    font-size: 14px;
  }
  .info-label {
    color: #64748b;
    font-weight: 500;
  }
  .info-val {
    color: #0f172a;
    font-weight: 600;
  }
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-top: 14px;
  }
  .stat-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 12px;
    text-align: center;
  }
  .stat-num {
    font-size: 20px;
    font-weight: 700;
    color: #1e3a8a;
  }
  .stat-lbl {
    font-size: 12px;
    color: #64748b;
    margin-top: 4px;
  }
  .portal-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
    font-size: 14px;
  }
  .portal-table th {
    background-color: #f1f5f9;
    color: #475569;
    font-weight: 600;
    text-align: left;
    padding: 10px 14px;
    border-radius: 4px;
  }
  .portal-table td {
    padding: 12px 14px;
    border-bottom: 1px solid #f1f5f9;
  }
  .badge {
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
  }
  .badge-pass { background: #dcfce7; color: #15803d; }
  .badge-fail { background: #fee2e2; color: #b91c1c; }
  .badge-paid { background: #e0e7ff; color: #3730a3; }
</style>

<div class="portal-container">
  <!-- Header -->
  <div class="portal-header">
    <div>
      <h1>🏫 School Parent & Student Portal</h1>
      <p>Logged in as: <strong><%=loggedInUser%></strong></p>
    </div>
    <div class="security-badge">
      🔒 Secure Child Data Access
    </div>
  </div>

  <!-- Row 1: Child Profile & Attendance -->
  <div class="grid-2">
    <!-- Child Profile Card -->
    <div class="card">
      <div class="card-title">👤 Student Profile</div>
      <%
      if(students != null && students.size() > 0)
      {
          st = students.get(0);
          sName = st.get("Full_Name");
          if(sName == null) { sName = st.get("Last_Name"); }
          sEmail = st.get("Email");
          sPhone = st.get("Phone");
          sId = st.get("id");
      %>
        <div class="info-row"><span class="info-label">Student Name:</span><span class="info-val"><%=sName%></span></div>
        <div class="info-row"><span class="info-label">Student ID / System ID:</span><span class="info-val"><%=sId%></span></div>
        <div class="info-row"><span class="info-label">Parent Registered Email:</span><span class="info-val"><%=sEmail%></span></div>
        <div class="info-row"><span class="info-label">Contact Phone:</span><span class="info-val"><%=sPhone%></span></div>
        <div class="info-row"><span class="info-label">Enrollment Status:</span><span class="info-val"><span class="badge badge-pass">Active</span></span></div>
      <%
      }
      else
      {
      %>
        <p style="color: #64748b;">No active student records linked to this parent login.</p>
      <%
      }
      %>
    </div>

    <!-- Attendance Card -->
    <div class="card">
      <div class="card-title">📅 Attendance Overview</div>
      <div class="info-row"><span class="info-label">Overall Attendance Rate:</span><span class="info-val" style="color: #15803d;">92.5%</span></div>
      <div class="info-row"><span class="info-label">Academic Year:</span><span class="info-val">2026-2027</span></div>
      <div class="stat-grid">
        <div class="stat-box"><div class="stat-num">120</div><div class="stat-lbl">Total Days</div></div>
        <div class="stat-box"><div class="stat-num" style="color: #15803d;">111</div><div class="stat-lbl">Present</div></div>
        <div class="stat-box"><div class="stat-num" style="color: #b91c1c;">7</div><div class="stat-lbl">Absent</div></div>
        <div class="stat-box"><div class="stat-num" style="color: #d97706;">2</div><div class="stat-lbl">Late</div></div>
      </div>
    </div>
  </div>

  <!-- Row 2: Examination Results -->
  <div class="card" style="margin-bottom: 24px;">
    <div class="card-title">📝 Examination Results & Grades</div>
    <table class="portal-table">
      <thead>
        <tr>
          <th>Result ID / Subject</th>
          <th>Marks Obtained</th>
          <th>Max Marks</th>
          <th>Percentage</th>
          <th>Grade</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <%
        if(resultsList != null && resultsList.size() > 0)
        {
            for each res in resultsList
            {
                rName = res.get("Name");
                mObt = res.get("Marks_Obtained");
                mMax = res.get("Maximum_Marks");
                pct = res.get("Percentage");
                grd = res.get("Grade");
                rStatus = res.get("Result_Status");
                if(rStatus == null || rStatus == "") { rStatus = "Pass"; }
                statusClass = "badge-pass";
                if(rStatus == "Fail") { statusClass = "badge-fail"; }
        %>
          <tr>
            <td><strong><%=rName%></strong></td>
            <td><%=mObt%></td>
            <td><%=mMax%></td>
            <td><strong><%=pct%>%</strong></td>
            <td><span class="badge badge-paid"><%=grd%></span></td>
            <td><span class="badge <%=statusClass%>"><%=rStatus%></span></td>
          </tr>
        <%
            }
        }
        else
        {
        %>
          <tr><td colspan="6" style="text-align:center; color:#64748b;">No examination results published yet.</td></tr>
        <%
        }
        %>
      </tbody>
    </table>
  </div>

  <!-- Row 3: Fees & Payments -->
  <div class="card">
    <div class="card-title">💳 Fees & Payment History</div>
    <div class="grid-2" style="margin-bottom: 16px;">
      <div class="stat-box" style="background:#eff6ff;"><div class="stat-num">₹ 45,000</div><div class="stat-lbl">Total Annual Fee</div></div>
      <div class="stat-box" style="background:#f0fdf4;"><div class="stat-num" style="color:#15803d;">₹ 45,000</div><div class="stat-lbl">Total Paid</div></div>
    </div>

    <table class="portal-table">
      <thead>
        <tr>
          <th>Payment ID</th>
          <th>Payment Date</th>
          <th>Amount Paid</th>
          <th>Payment Method</th>
          <th>Transaction Reference</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <%
        if(paymentsList != null && paymentsList.size() > 0)
        {
            for each pay in paymentsList
            {
                pId = pay.get("Name");
                pDate = pay.get("Payment_Date");
                pAmt = pay.get("Amount_Paid");
                pMethod = pay.get("Payment_Method");
                pRef = pay.get("Transaction_Reference");
                pStatus = pay.get("Payment_Status");
                if(pStatus == null || pStatus == "") { pStatus = "Successful"; }
        %>
          <tr>
            <td><strong><%=pId%></strong></td>
            <td><%=pDate%></td>
            <td><strong>₹ <%=pAmt%></strong></td>
            <td><%=pMethod%></td>
            <td><%=pRef%></td>
            <td><span class="badge badge-pass"><%=pStatus%></span></td>
          </tr>
        <%
            }
        }
        else
        {
        %>
          <tr><td colspan="6" style="text-align:center; color:#64748b;">No payment records found.</td></tr>
        <%
        }
        %>
      </tbody>
    </table>
  </div>
</div>
